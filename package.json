{
  "name": "mini-lab-back",
  "version": "1.0.0",
  "description": "API backend para sistema de laboratorio",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint src tests scripts",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run typecheck:test && npm run lint && npm run test && npm run format:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:passwords": "tsx scripts/migrate-employee-passwords.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "express": "^5.0.0",
    "express-rate-limit": "^8.7.2",
    "jose": "^6.2.15",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
